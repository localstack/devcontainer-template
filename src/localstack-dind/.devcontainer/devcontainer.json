{
	"name": "LocalStack DinD setup",
	"image": "mcr.microsoft.com/devcontainers/base:${templateOption:imageVariant}",

	"remoteEnv": {
		// LocalStack Auth Token (required to start LocalStack): https://docs.localstack.cloud/aws/getting-started/auth-token/
		"LOCALSTACK_AUTH_TOKEN": "${localEnv:LOCALSTACK_AUTH_TOKEN}",  // required, not processed via template due to security reasons
		"AWS_REGION": "${templateOption:defaultRegion}",
		"AWS_DEFAULT_REGION": "${templateOption:defaultRegion}"
		// LocalStack itself is configured in .devcontainer/lstk.toml
	},

	// 👇 Features to add to the Dev Container. More info: https://containers.dev/implementors/features.
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},

	// 👇 Install lstk, the LocalStack CLI: https://github.com/localstack/lstk
	// lstk also proxies aws, terraform, cdk, sam and az commands to LocalStack. The wrapped tools are not installed,
	// if needed add features manually, e.g. ghcr.io/devcontainers/features/aws-cli, ghcr.io/devcontainers/features/terraform
	"onCreateCommand": "bash .devcontainer/install-lstk.sh .devcontainer/lstk.toml",

	// 👇 Start LocalStack once the Docker daemon (started in the background by the docker-in-docker feature) is ready
	"postCreateCommand": "if ${templateOption:startup}; then timeout 120 sh -c 'until docker info > /dev/null 2>&1; do sleep 1; done' && lstk --non-interactive start --timeout 3m; fi",
	"mounts": [
		{
			// to persist build data and images
			"source": "dind-var-lib-docker",
			"target": "/var/lib/docker",
			"type": "volume"
		},
		{
			"source": "${templateOption:volumePath}",
			"target": "/data",
			"type": "bind",
			"consistency": "cached"
		}
	]
}
