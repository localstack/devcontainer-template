{
	"name": "LocalStack DinD setup",
	"image": "mcr.microsoft.com/devcontainers/base:${templateOption:imageVariant}",

	"remoteEnv": {
		// LocalStack auth token: https://docs.localstack.cloud/aws/getting-started/auth-token/
		// Read from the host and never written into the template. You can also run `lstk login` in the container.
		"LOCALSTACK_AUTH_TOKEN": "${localEnv:LOCALSTACK_AUTH_TOKEN}",
		"AWS_REGION": "${templateOption:defaultRegion}",
		"AWS_DEFAULT_REGION": "${templateOption:defaultRegion}",
		// `aws` and the AWS SDKs use the `localstack` profile written by `lstk setup aws`.
		// Do not set AWS_ENDPOINT_URL here: `lstk start` refuses to run when it is set.
		"AWS_PROFILE": "localstack"
	},

	// 👇 Features to add to the Dev Container. More info: https://containers.dev/implementors/features.
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4": {},
		// `lstk aws` and the `localstack` profile need the AWS CLI.
		"ghcr.io/devcontainers/features/aws-cli:1": {},
		// Installs lstk. For `lstk terraform`, `lstk cdk` or `lstk sam`, also add
		// ghcr.io/devcontainers/features/terraform:1, ghcr.io/devcontainers-extra/features/aws-cdk:2
		// or ghcr.io/customink/codespaces-features/sam-cli:1.
		"ghcr.io/localstack/devcontainer-feature/localstack-cli:1": {}
	},

	// lstk reads .devcontainer/lstk/config.toml through ~/.config/lstk/config.toml.
	"postCreateCommand": "bash .devcontainer/lstk/post-create.sh",
	// Starts LocalStack on every container start, as the inner Docker daemon restarts with the container.
	"postStartCommand": "bash .devcontainer/lstk/post-start.sh ${templateOption:startup}",

	"mounts": [
		{
			// LocalStack state (/var/lib/localstack), kept across container rebuilds.
			"source": "localstack-data-${devcontainerId}",
			"target": "/data",
			"type": "volume"
		}
	]
}
