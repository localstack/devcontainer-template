{
    "id": "localstack-dind",
    "version": "1.0.0",
    "name": "LocalStack Docker-in-Docker",
    "description": "Runs LocalStack inside the dev container's own Docker daemon and manages it with lstk.",
    "documentationURL": "https://github.com/localstack/devcontainer-template/tree/main/src/localstack-dind",
    "licenseURL": "https://github.com/localstack/devcontainer-template/blob/main/LICENSE",
    "options": {
        "imageVariant": {
            "type": "string",
            "description": "Ubuntu or Debian version of the base image:",
            "proposals": [
                "noble",
                "jammy",
                "resolute",
                "bookworm"
            ],
            "default": "noble"
        },
        "version": {
            "type": "string",
            "description": "LocalStack image tag (localstack/localstack-pro):",
            "proposals": [
                "latest",
                "stable",
                "2026.10"
            ],
            "default": "latest"
        },
        "logLevel": {
            "type": "string",
            "description": "LocalStack log level (LS_LOG):",
            "enum": [
                "trace",
                "trace-internal",
                "debug",
                "info",
                "warn",
                "error",
                "warning"
            ],
            "default": "info"
        },
        "debug": {
            "type": "boolean",
            "description": "Enable LocalStack debug mode (DEBUG):",
            "default": false
        },
        "persistence": {
            "type": "boolean",
            "description": "Persist LocalStack state across restarts (PERSISTENCE):",
            "default": false
        },
        "enforceIam": {
            "type": "boolean",
            "description": "Enforce IAM policies (ENFORCE_IAM):",
            "default": false
        },
        "loadPods": {
            "type": "string",
            "description": "Cloud Pods to load at start-up, comma-separated (AUTO_LOAD_POD):",
            "default": ""
        },
        "defaultRegion": {
            "type": "string",
            "description": "Default AWS region for the AWS CLI and SDKs:",
            "proposals": [
                "us-east-1",
                "us-east-2",
                "us-west-1",
                "us-west-2",
                "af-south-1",
                "ap-east-1",
                "ap-south-1",
                "ap-south-2",
                "ap-southeast-1",
                "ap-southeast-2",
                "ap-southeast-3",
                "ap-southeast-4",
                "ap-northeast-1",
                "ap-northeast-2",
                "ap-northeast-3",
                "ca-central-1",
                "ca-west-1",
                "eu-central-1",
                "eu-central-2",
                "eu-west-1",
                "eu-west-2",
                "eu-west-3",
                "eu-south-1",
                "eu-south-2",
                "eu-north-1",
                "il-central-1",
                "me-south-1",
                "me-central-1",
                "sa-east-1"
            ],
            "default": "us-east-1"
        },
        "startup": {
            "type": "boolean",
            "description": "Start LocalStack with lstk when the container starts:",
            "default": true
        }
    },
    "platforms": [
        "Any"
    ],
    "keywords": [
        "localstack",
        "lstk",
        "aws",
        "docker-in-docker"
    ]
}
