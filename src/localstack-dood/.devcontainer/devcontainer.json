{
	"name": "LocalStack DooD setup",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

	// 👇 Features to add to the Dev Container. More info: https://containers.dev/implementors/features.
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
	}

	// lstk, the LocalStack CLI (https://github.com/localstack/lstk), is installed in the Dockerfile. It talks to the LocalStack
	// container from docker-compose.yml via AWS_ENDPOINT_URL (set in .env) and proxies aws, terraform, cdk, sam and az commands to it.
	// The wrapped tools are not installed, if needed add features manually, e.g. ghcr.io/devcontainers/features/aws-cli
}
