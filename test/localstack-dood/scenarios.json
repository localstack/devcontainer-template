{
    "custom_host_iam_and_region": {
        "host": "my-host.localstack.cloud:4566",
        "defaultRegion": "eu-central-1",
        "enforceIam": true
    },
    "persistence_pinned_version_on_jammy": {
        "imageVariant": "jammy",
        "version": "2026.10",
        "persistence": true,
        "volumePath": "./volume"
    },
    "terraform_pod_and_debug_on_bookworm": {
        "imageVariant": "bookworm",
        "features": {
            "ghcr.io/devcontainers/features/terraform:1": {}
        },
        "loadPods": "devcontainer-template-ci-dood",
        "debug": true,
        "logLevel": "trace"
    }
}
