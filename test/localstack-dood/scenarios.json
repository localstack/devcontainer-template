{
    "tools": {
        "imageVariant": "jammy",
        "startup": false
    },
    "debug_mode_on_bookworm": {
        "imageVariant": "bookworm",
        "debug": true,
        "logLevel": "trace"
    },
    "use_pro_and_pod": {
        "features": {
            "ghcr.io/devcontainers/features/aws-cli:1": {}
        },
        "loadPods": "devcontainer-use_pro_and_pod"
    },
    "custom_volume_and_host_with_2026_9": {
        "features": {
            "ghcr.io/devcontainers/features/aws-cli:1": {}
        },
        "version": "2026.9.1",
        "volumePath": "./volume",
        "host": "my-host.localstack.cloud:4566"
    },
    "custom_region_with_iam_enforce": {
        "features": {
            "ghcr.io/devcontainers/features/aws-cli:1": {}
        },
        "defaultRegion": "eu-central-1",
        "enforceIam": true
    }
}