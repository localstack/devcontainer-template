{
    "iac_tools_on_jammy": {
        "imageVariant": "jammy",
        "features": {
            "ghcr.io/devcontainers/features/terraform:1": {},
            "ghcr.io/devcontainers/features/node:1": {},
            "ghcr.io/devcontainers-extra/features/aws-cdk:2": {},
            "ghcr.io/customink/codespaces-features/sam-cli:1": {}
        }
    },
    "persistence_pinned_version_on_bookworm": {
        "imageVariant": "bookworm",
        "version": "2026.10",
        "persistence": true
    },
    "iam_region_and_debug": {
        "defaultRegion": "eu-central-1",
        "enforceIam": true,
        "debug": true,
        "logLevel": "trace"
    },
    "load_pod": {
        "imageVariant": "resolute",
        "loadPods": "devcontainer-template-ci-dind"
    },
    "no_startup": {
        "startup": false
    }
}
